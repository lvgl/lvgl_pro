<widget>
    <api>
        <enumdef name="lv_table_cell_ctrl" help="Cell control flags">
            <enum name="merge_right" value="1" help="Merge with right cell"/>
            <enum name="text_crop" value="2" help="Crop text if too long"/>
            <enum name="custom_1" value="16" help="User flag 1"/>
            <enum name="custom_2" value="32" help="User flag 2"/>
            <enum name="custom_3" value="64" help="User flag 3"/>
            <enum name="custom_4" value="128" help="User flag 4"/>
        </enumdef>

        <prop name="row_count" type="int" help="Set row count"/>
        <prop name="column_count" type="int" help="Set column count"/>

        <element name="column" access="set" help="Configure a table column">
            <arg name="column" type="int" help="Column index (0-based)"/>
            <prop name="width" type="px" help="Set column width"/>
        </element>

        <element name="cell" access="set" help="Configure a table cell">
            <arg name="row" type="int" help="Row index (0-based)"/>
            <arg name="column" type="int" help="Column index (0-based)"/>
            <prop name="value" type="string" help="Set cell text"/>
            <prop name="ctrl" type="enum:lv_table_cell_ctrl+" help="Set cell flags"/>
        </element>

        <parts>
            <part name="main" help="The table's outer frame and background: background, border and padding properties."/>
            <part name="items" help="The cells: background and text properties, applied uniformly to all cells. Per-cell variations need cell ctrl flags or draw events."/>
            <part name="scrollbar" help="The scrollbar shown when the table is larger than its area: `width` (thickness), background properties and padding."/>
        </parts>
    </api>
</widget>
