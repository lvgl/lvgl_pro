<component>
	<previews>
		<preview name="default" width="400" />
	</previews>

	<api>
		<prop name="text" type="string" default="Heading 1" help="Heading text" />
	</api>

	<styles>
		<style name="style_h1" text_font="font_h1" />
	</styles>

	<!-- Largest heading. Text color inherited; override per-use with style_text_color. -->
	<view extends="lv_label" text="$text">
		<style name="style_h1" />
	</view>
</component>
