# Only what the demo needs; lv_conf.h is generated from this and LVGL's
# template by scripts/generate_lv_conf.py, which CMake runs for you.

LV_COLOR_DEPTH          32

# malloc rather than a fixed pool, so a full-screen snapshot fits
LV_USE_STDLIB_MALLOC    LV_STDLIB_CLIB
LV_USE_STDLIB_STRING    LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF   LV_STDLIB_CLIB

# The window and input devices
LV_USE_SDL              1

# The converter renders the screen with lv_snapshot_take()
LV_USE_SNAPSHOT         1

LV_USE_DEMO_WIDGETS     1
LV_FONT_MONTSERRAT_14   1
LV_FONT_MONTSERRAT_16   1
LV_FONT_MONTSERRAT_24   1

LV_USE_LOG              0
